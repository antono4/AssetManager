# ============================================================================
#  Konfigurasi database untuk AssetManager (MySQL saja)
#  Salin file ini menjadi ".env" (tanpa .example) lalu sesuaikan.
#  Contoh: cp .env.example .env
#
#  Prioritas: env var OS > file .env > nilai default bawaan config.php
#  Default bawaan config.php: mysql / assets_app / root / (password kosong)
# ============================================================================

# --- Driver: hanya 'mysql' (koneksi demo SQLite sudah dihapus) ---
DB_DRIVER=mysql

# --- Koneksi MySQL (default: XAMPP localhost, user root tanpa password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
# Nama database. Buat dulu lewat phpMyAdmin atau:
#   CREATE DATABASE assets_app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_NAME=assets_app
# User MySQL XAMPP default: root / (password kosong)
DB_USER=root
DB_PASS=

# --- (Opsional) Base URL bila app di-deploy di sub-folder ---
# APP_BASE_URL=/asset_app
