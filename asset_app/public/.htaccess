DirectoryIndex index.php index.html

RewriteEngine On

# Izinkan akses langsung HANYA ke file static dengan ekstensi tertentu
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot|map)$ - [L]

# SEMUA request lain (termasuk /assets, /dashboard, /login, folder) ke index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Block akses file sensitif
<FilesMatch "\.(sql|sqlite|md|log)$">
    Require all denied
</FilesMatch>

Options -Indexes
