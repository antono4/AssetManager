# Pastikan index.php jadi default file untuk folder
DirectoryIndex index.php index.html

RewriteEngine On

# Izinkan akses langsung ke file static yang ada (CSS, JS, gambar, uploads)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Redirect semua request lain (termasuk folder/PATH) ke index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Keamanan: block akses file sensitif
<FilesMatch "\.(sql|sqlite|md|log)$">
    Require all denied
</FilesMatch>

# Block directory listing (tapi index.php tetap di-serve)
Options -Indexes
